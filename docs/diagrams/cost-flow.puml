@startuml cost-flow
skinparam defaultFontName Helvetica
skinparam shadowing false
skinparam ArrowColor #444
skinparam sequenceMessageAlign center
skinparam participant {
  BackgroundColor #F4F6F8
  BorderColor #888
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #888
}
skinparam note {
  BackgroundColor #FFF6DD
  BorderColor #B8860B
}

participant "skill\n(session)" as S
participant "PreToolUse hook\n(Agent)" as ASSIGN
participant "PreToolUse hook\n(Bash)" as PRE
database ".git/tdd-sdlc/\nsessions/<session>" as MAP
participant "sub-agent" as A
participant "SubagentStop hook" as STOP
database "docs/<n>-<task>/\nreview/cost.jsonl" as JSONL
participant "cost.sh report" as REP
database "rates: bundled\npricing.json, user cache" as RATES
database "docs/<n>-<task>/\nreview/cost.md" as MD
database "docs/<n>-<task>/\nreview/activity.html" as HTML

S -> PRE : plan.sh status docs/7-x/plan.md
PRE -> MAP : session -> docs/7-x
note right of PRE
  any framework script call
  naming a task directory
end note
S -> ASSIGN : spawn implementation agent
ASSIGN -> ASSIGN : derive workflow, work file,\nitem ids and basis
ASSIGN -> A : normalized prompt with\nassignment header
A -> STOP : agent ends
STOP -> STOP : type is a framework agent?\nassignment path, else the mapping
STOP -> JSONL : one line: time, session, type, model,\nturns, token counts, activity intervals,\nwall time, offset, plan
S -> REP : at the task's finish
REP -> JSONL : read
REP -> RATES : rate per model;\nfetched when a model is new\nor the cache is a week old
REP -> MD : dollars and counts per session,\nper plan, per agent type
REP -> HTML : deterministic template + embedded\nassignments and intervals
@enduml
